{
  "name": "spelling-coach-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch app/server.ts",
    "postinstall": "node scripts/fix-deepagents-anthropic-zod.mjs",
    "precompute:breakdowns": "tsx scripts/precomputeWordBreakdowns.ts",
    "precompute:concepts": "tsx scripts/precomputeConceptTeaching.ts",
    "precompute:related-forms": "tsx scripts/precomputeRelatedForms.ts",
    "precompute:g2p-pilot": "tsx scripts/precomputeG2pPilot.ts",
    "precompute:phonemes": "tsx scripts/precomputeWordPhonemes.ts",
    "audit:pronunciations": "tsx scripts/auditFriendlyPronunciations.ts",
    "test": "tsx --experimental-test-module-mocks --test app/tests/*.test.ts",
    "test:coverage": "tsx --experimental-test-module-mocks --test --experimental-test-coverage --test-coverage-include='app/*.ts' --test-coverage-include='api/*.ts' --test-coverage-exclude='app/testCases.ts' app/tests/*.test.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.0",
    "@langchain/openai": "^1.3.1",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@sentry/node": "^7.114.0",
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/speed-insights": "^2.0.0",
    "deepagents": "^0.0.0",
    "dotenv": "^17.4.2",
    "openai": "^6.5.0",
    "stripe": "^22.2.0",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  }
}
